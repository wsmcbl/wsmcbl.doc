@startuml
'skinparam BackgroundColor transparent

state "Padre \nde Familia" as cliente
state Secretario
state Dirección
state Docente
state Alumnado
state "Otro personal" as otros
state "Certificados \ny otros documentos" as documentos

state Cajero
state Caja
state "Pagos \nde aranceles" as aranceles

cliente --> Cajero : Paga a
cliente --> Secretario : Es atendido por

Cajero -> Secretario
Cajero --> aranceles : Gestiona los
Cajero --> Caja : Registra en

Secretario -> aranceles : Consulta los
Secretario --> documentos : Genera los
Secretario -up-> Dirección

Docente -le-> Secretario : Solicita/Entrega docuentos a
Docente --> Alumnado : Enseña a su

Dirección --> Secretario : Se comunica con
Dirección --> Docente : Gestiona a
Dirección -> otros : Gestiona a

@enduml